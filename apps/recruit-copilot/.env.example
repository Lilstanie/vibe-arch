# Copy to .env (or export in your shell) to enable live AI.
# With NO key set, the app runs fully on the mock layer — great for demos.
# Provider priority: OPENROUTER > OPENAI > ANTHROPIC > mock.

# --- OpenRouter (OpenAI-compatible gateway to many models) — first priority ---
# OPENROUTER_API_KEY=sk-or-v1-...
# Use a model that supports JSON mode for the structured agents:
# OPENROUTER_MODEL=openai/gpt-4o-mini
# NOTE: the host openrouter.ai must be reachable. In restricted egress
# environments add it to the network allowlist; locally it just works.

# --- OpenAI (ChatGPT) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) — alternative provider ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Force the offline mock even if a key is present:
# MOCK_LLM=1

# Server port (default 5178)
# PORT=5178
